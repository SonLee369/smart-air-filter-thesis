// AI feature F2 - edge AI benchmark on the ESP32-WROOM-32.
// Compares plain C float32 inference with TensorFlow Lite Micro int8 on the same
// models, plus two MPC search workloads. Weights are random (generated by
// ai/bench/make_bench_models.py): this measures speed, memory and correctness of
// the runtime, not prediction quality.
//
// Output (115200 baud): one markdown table, then CSV lines starting with "CSV,".
// Build with -DBENCH_TFLM=0 to measure the firmware size without TFLite Micro.

#ifndef BENCH_TFLM
#define BENCH_TFLM 1
#endif

#include <Arduino.h>
#include <esp_timer.h>
#include "c_infer.h"
#include "bench_data.h"
#include "bench_util.h"

#if BENCH_TFLM
#include <Chirale_TensorFlowLite.h>
#include "tensorflow/lite/micro/micro_interpreter.h"
#include "tensorflow/lite/micro/micro_mutable_op_resolver.h"
#include "tensorflow/lite/schema/schema_generated.h"
#include "models_tflm.h"

constexpr size_t kArenaSize = 32 * 1024;
alignas(16) static uint8_t arena[kArenaSize];
#endif

static const int kRuns = 200;

struct Row {
  const char* model;
  const char* runtime;
  float us;          // mean latency per inference
  float err;         // max |device - reference|
  int modelBytes;
  int ramBytes;      // TFLM arena used, or C scratch estimate
};

static Row rows[16];
static int nRows = 0;

static volatile float sink;   // keeps the compiler from removing timed work

static void benchC(const char* name, float (*fn)(const float*), const float* x, const float* ref,
                   int n, int params, int scratch) {
  float err = 0;
  for (int i = 0; i < BENCH_N_TEST; i++) err = fmaxf(err, fabsf(fn(x + i * n) - ref[i]));
  float us = timeUs([&](int i) { sink = fn(x + (i % BENCH_N_TEST) * n); }, kRuns);
  rows[nRows++] = {name, "C float32", us, err, params * 4, scratch};
}

#if BENCH_TFLM
static void benchTflm(const char* name, const unsigned char* buf, const float* q,
                      const float* x, const float* refTfl, int n) {
  const tflite::Model* model = tflite::GetModel(buf);
  static tflite::MicroMutableOpResolver<5> resolver;
  static bool once = false;
  if (!once) {
    resolver.AddFullyConnected();
    resolver.AddConv2D();
    resolver.AddExpandDims();
    resolver.AddMean();
    resolver.AddReshape();
    once = true;
  }
  tflite::MicroInterpreter interp(model, resolver, arena, kArenaSize);
  if (interp.AllocateTensors() != kTfLiteOk) {
    Serial.printf("[TFLM] %s: AllocateTensors failed\n", name);
    return;
  }
  TfLiteTensor* in = interp.input(0);
  TfLiteTensor* out = interp.output(0);
  float si = q[0], zi = q[1], so = q[2], zo = q[3];
  auto load = [&](const float* v) {
    for (int j = 0; j < n; j++) {
      int qv = (int)lroundf(v[j] / si + zi);
      in->data.int8[j] = (int8_t)(qv < -128 ? -128 : qv > 127 ? 127 : qv);
    }
  };
  float err = 0;
  for (int i = 0; i < BENCH_N_TEST; i++) {
    load(x + i * n);
    interp.Invoke();
    float y = (out->data.int8[0] - zo) * so;
    err = fmaxf(err, fabsf(y - refTfl[i]));
  }
  load(x);
  float us = timeUs([&](int) { interp.Invoke(); sink = out->data.int8[0]; }, kRuns);
  int modelBytes = 0;
  if (!strcmp(name, "mlp_s")) modelBytes = sizeof(mlp_s_tflite);
  else if (!strcmp(name, "mlp_m")) modelBytes = sizeof(mlp_m_tflite);
  else if (!strcmp(name, "cnn")) modelBytes = sizeof(cnn_tflite);
  rows[nRows++] = {name, "TFLM int8", us, err, modelBytes, (int)interp.arena_used_bytes()};
}
#endif

void setup() {
  Serial.begin(115200);
  delay(1500);
  Serial.printf("\nEdge AI benchmark - %s @ %lu MHz, free heap %lu B, runs per model %d\n",
                ESP.getChipModel(), (unsigned long)ESP.getCpuFreqMHz(),
                (unsigned long)ESP.getFreeHeap(), kRuns);

  benchC("mlp_s", run_mlp_s, mlp_s_x, mlp_s_y_ref, 30, 2081, 2 * 32 * 4);
  benchC("mlp_m", run_mlp_m, mlp_m_x, mlp_m_y_ref, 60, 8129, 2 * 64 * 4);
  benchC("cnn", run_cnn, cnn_x, cnn_y_ref, 90, 961, (28 + 26) * 16 * 4);
  benchC("gru", run_gru, gru_x, gru_y_ref, 90, 3585, (3 * 64 * 2 + 64 + 32) * 4);
  benchC("plant", run_plant, plant_x, plant_y_ref, 8, 161, 16 * 4);
#if BENCH_TFLM
  benchTflm("mlp_s", mlp_s_tflite, mlp_s_q, mlp_s_x, mlp_s_y_tfl, 30);
  benchTflm("mlp_m", mlp_m_tflite, mlp_m_q, mlp_m_x, mlp_m_y_tfl, 60);
  benchTflm("cnn", cnn_tflite, cnn_q, cnn_x, cnn_y_tfl, 90);
#endif

  // MPC workloads with the plant model (C float32)
  float x0[8] = {60, 40, 0.2f, 55, 70, 30, 1300, 8};
  float usA = timeUs([&](int) { sink = mpc_search_const(x0, 11, 10, 0.2f); }, 20);
  float usB = timeUs([&](int) { sink = mpc_search_tree(x0, 5, 0.2f); }, 5);

  Serial.println("\n| Model | Runtime | Latency (us) | Max error | Model bytes | RAM bytes |");
  Serial.println("|---|---|---|---|---|---|");
  for (int i = 0; i < nRows; i++)
    Serial.printf("| %s | %s | %.1f | %.2e | %d | %d |\n", rows[i].model, rows[i].runtime,
                  rows[i].us, rows[i].err, rows[i].modelBytes, rows[i].ramBytes);
  Serial.printf("| MPC A: 11 levels x H=10 (110 plant calls) | C float32 | %.1f | - | 644 | - |\n", usA);
  Serial.printf("| MPC B: 3^5 sequences x H=5 (1215 plant calls) | C float32 | %.1f | - | 644 | - |\n", usB);
  Serial.printf("\nMin free heap during run: %lu B\n", (unsigned long)ESP.getMinFreeHeap());

  for (int i = 0; i < nRows; i++)
    Serial.printf("CSV,%s,%s,%.2f,%.3e,%d,%d\n", rows[i].model, rows[i].runtime, rows[i].us,
                  rows[i].err, rows[i].modelBytes, rows[i].ramBytes);
  Serial.printf("CSV,mpc_const_11x10,C float32,%.2f,,644,\n", usA);
  Serial.printf("CSV,mpc_tree_3^5,C float32,%.2f,,644,\n", usB);
  Serial.println("BENCH DONE");
}

void loop() { delay(1000); }
